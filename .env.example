# n8n webhook URL that receives the generated report.
# Copy this file to .env and fill in your real webhook URL.
# The URL looks like: https://your-n8n-host.example.com/webhook/sales-report
N8N_WEBHOOK_URL=

# Optional: the email address the recipient n8n workflow should deliver to.
# Used only as metadata in the webhook payload.
REPORT_RECIPIENT_EMAIL=

# --- Direct Python email (optional, works alongside n8n) ---
# Enable by setting email.enabled=true in config.yaml and filling these.
# Works with Gmail (app password), Outlook, SendGrid, Mailgun, or any SMTP server.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
# EMAIL_SUBJECT is optional; defaults to config.yaml subject_template
# EMAIL_SUBJECT=Sales Report - Northstar Commerce

# Optional: SMTP credentials for the n8n workflow (NOT used by Python).
# These belong to the n8n Email node configuration, kept here only as a reference.
# N8N_SMTP_HOST=
# N8N_SMTP_USER=
# N8N_SMTP_PASS=
