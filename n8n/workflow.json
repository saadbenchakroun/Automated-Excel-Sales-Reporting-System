{
  "name": "Northstar Commerce - Sales Report Email",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sales-report",
        "responseMode": "responseNode",
        "options": {
          "responseData": "allEntries"
        }
      },
      "id": "d30cedef-c69d-4ac4-b51e-667eb186c29b",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "d30cedef-c69d-4ac4-b51e-667eb186c29b"
    },
    {
      "parameters": {
        "fromEmail": "reports@northstar-commerce.example",
        "toEmail": "={{ $json['report_recipient_email'] || 'management@northstar-commerce.example' }}",
        "subject": "=Sales Report {{ $json['period_start'] }} to {{ $json['period_end'] }} ({{ $json['company_name'] }})",
        "emailFormat": "text",
        "text": "=Hello,\n\nThe automated sales report is attached.\n\nCompany: {{ $json['company_name'] }}\nPeriod: {{ $json['period_start'] }} to {{ $json['period_end'] }}\nTotal revenue: {{ $json['currency'] }} {{ $json['total_revenue'] }}\nTotal orders: {{ $json['total_orders'] }}\nUnits sold: {{ $json['total_units'] }}\n\nGenerated at: {{ $json['generated_at'] }}\nStatus: {{ $json['status'] }}\n\nThis email was produced automatically by the n8n workflow triggered by the Python pipeline.",
        "attachments": "report"
      },
      "id": "f2f717e3-aa22-4ce2-954c-791d5a2f9936",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1.2,
      "position": [240, 300],
      "credentials": {
        "smtp": {
          "id": "YOUR_SMTP_CREDENTIALS_HERE",
          "name": "SMTP Account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, message: 'Report email sent', report_name: $json['report_name'] }) }}",
        "options": {}
      },
      "id": "91b0c2c2-0811-48ef-ba50-698ad0184dfa",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [480, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "instanceId": "portfolio-demo"
  }
}
